{
  "name": "shoetrak-monorepo",
  "description": "Mono repositório para aplicativos e pacotes da Shoetrak.",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10.5.0"
  },
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@shoetrak/eslint": "*",
    "@shoetrak/typescript": "*",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3"
  }
}
